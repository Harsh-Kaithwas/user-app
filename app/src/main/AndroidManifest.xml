<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LwinR"
        tools:targetApi="31">
        <activity
            android:name=".LeaderboardActivity"
            android:exported="false" />
        <activity
            android:name=".NotificationsActivity"
            android:exported="false"
            android:theme="@style/Theme.LwinR" />
        <activity
            android:name=".CheckInActivity"
            android:exported="false" />
        <activity
            android:name=".ReferEarnActivity"
            android:exported="false" />
        <activity
            android:name=".WalletActivity"
            android:exported="false" />

        <!-- App launcher: checks session and routes user to Login or Main screen -->
        <activity
            android:name=".SplashRouterActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
         Demo AdMob App ID.
        Replace it with your own AdMob App ID in a private/local project.
        Do not commit production AdMob configuration to a public repository.
        -->

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        
        <activity
            android:name=".LoginActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".LuckyDrawActivity"
            android:exported="false"
            android:theme="@style/Theme.LwinR" />
        <activity
            android:name=".WithdrawActivity"
            android:exported="false"
            android:theme="@style/Theme.LwinR" />
        <activity
            android:name=".UserProfileSetupActivity"
            android:exported="false" />
    </application>

</manifest>
