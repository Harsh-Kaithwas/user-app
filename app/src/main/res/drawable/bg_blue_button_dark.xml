<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="270"
                android:startColor="#173D7A"
                android:endColor="#102B58" />
            <stroke
                android:width="1dp"
                android:color="#6EA8FF" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="270"
                android:startColor="#295CAD"
                android:endColor="#173B79" />
            <stroke
                android:width="1dp"
                android:color="#7AB7FF" />
        </shape>
    </item>

</selector>