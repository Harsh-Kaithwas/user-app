<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="270"
                android:startColor="#5A2CB4"
                android:endColor="#3D1E7C" />
            <stroke
                android:width="1dp"
                android:color="#B08BFF" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="270"
                android:startColor="#6E35D5"
                android:endColor="#4D24A0" />
            <stroke
                android:width="1dp"
                android:color="#C09BFF" />
        </shape>
    </item>

</selector>